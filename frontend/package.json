{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "test:e2e": "bash ../scripts/e2e.sh",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "pretest": "npm run typecheck:test",
    "test:shuffle": "vitest run --sequence.shuffle",
    "pretest:shuffle": "npm run typecheck:test"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@lit/context": "^1.1.6",
    "@tiptap/core": "^3.34.0",
    "@tiptap/extension-bubble-menu": "^3.34.0",
    "@tiptap/extension-color": "^3.34.0",
    "@tiptap/extension-link": "^3.34.0",
    "@tiptap/extension-text-align": "^3.34.0",
    "@tiptap/extension-text-style": "^3.34.0",
    "@tiptap/extension-underline": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "@types/css": "^0.0.38",
    "css": "^3.0.0",
    "lit": "^3.3.3",
    "openpgp": "^6.3.2",
    "postal-mime": "^4.2.1",
    "rrule": "^2.8.1",
    "unicode-emoji-picker": "^2.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/openpgp": "^4.4.22",
    "jsdom": "^27.4.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
